BOT_TOKEN=123456789:telegram_bot_token
CHAT_ID=-1001234567890
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
SCAN_INTERVAL_MINUTES=30
SCAN_ON_STARTUP=true
UZEX_TRADE_LIST_URL=https://etender.uzex.uz/api/Trade/GetTradeList
UZEX_GET_TRADE_URL=https://etender.uzex.uz/api/Trade/GetTrade
UZEX_BASE_URL=https://etender.uzex.uz
UZEX_PAGE_SIZE=100
MAX_PAGES=5
REQUEST_TIMEOUT_SECONDS=25
SCAN_TIMEOUT_SECONDS=240
STUCK_SCAN_MINUTES=10
LOG_LEVEL=INFO
SHEET_WORKSHEET_NAME=Тендеры
TENDER_ARCHIVE_SHEET=Тендеры (архив)   # old tender sheet copied into the base; read only for dedup

# V36 stage 0: Coordinator
COORDINATOR_ENABLED=true
MANAGEMENT_CHAT_ID=          # empty = same as CHAT_ID
COORDINATOR_DIGEST_HOUR=9
COORDINATOR_TICK_MINUTES=5
FOLLOW_UP_DAYS=5
TELEGRAM_WEBHOOK_SECRET=     # any long random string; enables approval buttons
PUBLIC_BASE_URL=             # empty on Render: RENDER_EXTERNAL_URL is used
ADMIN_TOKEN=                 # protects /admin/*, /tasks, /coordinator/* POST

# V37 stage 1: Sales agent (letters go out only after approval in Telegram)
SALES_ENABLED=true
SALES_AUTO_PREPARE=false     # true = prepare a batch of letters every weekday at SALES_PREPARE_HOUR
SALES_DAILY_LIMIT=5
SALES_PREPARE_HOUR=10
MAIL_SMTP_HOST=smtp.mail.ru
MAIL_SMTP_PORT=465
MAIL_USER=ocean_logistics@mail.ru
MAIL_APP_PASSWORD=           # mail.ru "пароль для внешних приложений", not the normal password

# V43 stage 6: Dispatcher + Price agent (reads freight Telegram groups through a separate account)
DISPATCHER_ENABLED=true
TG_API_ID=                   # my.telegram.org -> API development tools
TG_API_HASH=
TG_SESSION=                  # from POST /dispatcher/login/finish; gives access to the account, keep secret
DISPATCHER_TICK_MINUTES=15
DISPATCHER_DIGEST_HOUR=18
DISPATCHER_GROUPS=           # empty = every group the account is in; or comma-separated name parts
